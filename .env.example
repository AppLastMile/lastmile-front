# REST API base URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Socket.IO host only (no /api/v1, no /ws/socket.io)
# Correct examples:
# - Local dev with Expo resolution: http://localhost:3000
# - Android emulator (manual): http://10.0.2.2:3000
# - Physical device (manual): http://<YOUR_PC_IP>:3000
EXPO_PUBLIC_WS_URL=http://localhost:3000

# Socket.IO namespace and path
EXPO_PUBLIC_WS_NAMESPACE=/ws
EXPO_PUBLIC_WS_PATH=/socket.io
# Optional: comma-separated list. For Expo mobile, `polling,websocket` is safer.
EXPO_PUBLIC_WS_TRANSPORTS=polling,websocket
EXPO_PUBLIC_WS_ALLOW_ANONYMOUS=false
EXPO_PUBLIC_WS_DEBUG=false
EXPO_PUBLIC_NETWORK_DEBUG=false

# Google OAuth — obtener en: https://console.cloud.google.com/
# Crear credencial tipo "Web application" y agregar http://localhost:8081 como redirect URI
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
